# Docker Compose settings. Copy to .env; every value below is the default.

# Postgres (the `db` service). Change the password outside local use,
# and keep DATABASE_URL in step with these three.
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex

# Connection used by `web` (Tamagotchi sync). `db` is the service name.
DATABASE_URL=postgres://pokedex:pokedex@db:5432/pokedex

# Win-prediction service as seen from the browser (inlined when `web` is built).
# Leave empty to run the exported model in the browser instead.
ML_API_URL=http://localhost:8000
# Origins allowed to call the ml service.
CORS_ORIGINS=http://localhost:3000

# Host ports.
WEB_PORT=3000
ML_PORT=8000
DB_PORT=5433
