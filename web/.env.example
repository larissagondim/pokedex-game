# Optional: URL of the win-prediction service (ml/, `uvicorn pokedex_ml.api:app`).
# Leave unset to run the exported model in the browser (no server needed).
# NEXT_PUBLIC_ML_API_URL=http://localhost:8000

# Optional: Postgres for the Tamagotchi sync (same party on every device, plus its diary).
# Leave unset to keep the save in this browser's localStorage only.
# With `docker compose up -d db` from the repo root:
# DATABASE_URL=postgres://pokedex:pokedex@localhost:5433/pokedex
